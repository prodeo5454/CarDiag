{
  "name": "cardiag",
  "version": "2.0.2",
  "private": true,
  "engines": {
    "node": ">=18.18.0"
  },
  "description": "CarDiag — Universal car diagnostic software",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/sync-app-version.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "build:oem-db": "node scripts/sync-oem-database.mjs",
    "typecheck": "tsc --noEmit",
    "android:init": "npx cap add android",
    "android:build": "node scripts/sync-app-version.mjs && cross-env STATIC_EXPORT=1 next build && npx cap sync android",
    "android:bundle": "npm run android:build && node scripts/android-gradle.mjs bundleRelease",
    "android:apk": "npm run android:build && node scripts/android-gradle.mjs assembleRelease",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^6.1.0",
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.378.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "recharts": "^2.12.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.3.0"
  },
  "overrides": {
    "es-abstract": "1.24.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
